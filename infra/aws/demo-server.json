{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Nafta2Go: demo por SSM, sin puertos de entrada; tunel HTTPS saliente opcional.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id",
      "Description": "VPC del stack nafta2go-network"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id",
      "Description": "Subred con ruta al internet gateway"
    },
    "ImageId": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "AMI Amazon Linux 2023 x86_64 revisada en Ohio; registrar el ID antes de crear el change set"
    },
    "EnergyHttpCidr": {
      "Type": "String",
      "Default": "",
      "Description": "Opcional: IPv4/32 verificada del portal publico de Energia; vacio mantiene solo HTTPS",
      "AllowedPattern": "^$|^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/32$"
    },
    "EnableCloudflareTunnel": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ],
      "Description": "Habilitar solo TCP 7844 hacia los veinte IPv4 publicados de Cloudflare Tunnel"
    }
  },
  "Resources": {
    "DemoSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Nafta2Go demo: sin entrada; salida HTTPS para SSM y dependencias",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "Fn::If": [
              "AllowEnergyHttp",
              {
                "IpProtocol": "tcp",
                "FromPort": 80,
                "ToPort": 80,
                "CidrIp": {
                  "Ref": "EnergyHttpCidr"
                },
                "Description": "Catalogo y CSV publicos de Energia; sin credenciales"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
              "AllowCloudflareTunnel",
              {
                "IpProtocol": "tcp",
                "FromPort": 7844,
                "ToPort": 7844,
                "CidrIp": "198.41.192.167/32",
                "Description": "Cloudflare Tunnel HTTP2; sin entrada publica"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          {
            "Fn::If": [
