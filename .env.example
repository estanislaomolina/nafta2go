# Clave de OpenRouteService (https://openrouteservice.org/dev/#/signup). No commitear el valor real.
ORS_API_KEY=

# Base de datos local de la POC (SQLite por defecto).
DATABASE_URL=sqlite:///data/nafta2go.db

# Token de acceso a la API local; exportar al entorno antes de iniciar Uvicorn.
NAFTA2GO_API_TOKEN=
