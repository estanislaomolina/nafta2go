# Clave de OpenRouteService (https://openrouteservice.org/dev/#/signup). No commitear el valor real.
ORS_API_KEY=

# Caché volátil de matrices y cupos conservadores por proceso y credencial.
ORS_CACHE_TTL_SECONDS=300
ORS_CACHE_MAX_ENTRIES=128
ORS_REQUESTS_PER_MINUTE=30
ORS_REQUESTS_PER_DAY=450

# Base de datos local de la POC (SQLite por defecto).
DATABASE_URL=sqlite:///data/nafta2go.db
